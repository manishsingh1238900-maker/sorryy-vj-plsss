<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>For Jahanvi</title>
<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Caveat:wght@500&display=swap" rel="stylesheet">
<style>
:root{--bg:#f6e9de;--bg2:#efd3c8;--ink:#5b3a3a;--rose:#d9647c;--paper:#fffaf3;--soft:rgba(255,255,255,.55);box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#f2e1d4;--bg2:#e8c8bc}}
:root[data-theme="dark"]{--bg:#f2e1d4;--bg2:#e8c8bc}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden;background:var(--bg);color:var(--ink);font-family:'Cormorant Garamond',Georgia,serif}
.slide{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;opacity:0;visibility:hidden;transform:translateY(16px);transition:opacity .9s ease,transform .9s ease,visibility .9s;background:radial-gradient(circle at 30% 10%,var(--bg) 0%,var(--bg2) 100%)}
.slide.on{opacity:1;visibility:visible;transform:none}
#lock{background:none;color:#fff;justify-content:space-between;padding:70px 24px 60px;overflow:hidden}
#lock .bg{position:absolute;inset:-30px;background-size:cover;background-position:center;filter:blur(14px) brightness(.8) saturate(1.1);transform:scale(1.1)}
#lock .shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(60,25,35,.25),rgba(60,25,35,.45))}
#lock>*:not(.bg):not(.shade){position:relative;z-index:2}
.clock{text-align:center}
.clock .time{font-size:92px;font-weight:600;line-height:1;letter-spacing:-2px}
.clock .date{font-size:21px;margin-top:6px;opacity:.9;font-style:italic}
.notif{width:100%;max-width:340px;background:rgba(255,255,255,.22);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.35);border-radius:18px;padding:12px 16px;animation:pop 1s .6s both}
.notif b{display:block;font-size:15px;letter-spacing:.5px}
.notif span{font-size:17px}
@keyframes pop{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
.track{position:relative;width:100%;max-width:320px;height:64px;border-radius:40px;background:rgba(255,255,255,.25);border:1px solid rgba(255,255,255,.45);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);touch-action:none;user-select:none;overflow:hidden}
.track .hint{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding-left:46px;font-size:19px;font-style:italic;letter-spacing:.5px;background:linear-gradient(90deg,rgba(255,255,255,.45) 0%,#fff 50%,rgba(255,255,255,.45) 100%);background-size:200% 100%;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;animation:shine 3s linear infinite}
@keyframes shine{from{background-position:200% 0}to{background-position:-200% 0}}
.knob{position:absolute;top:5px;left:5px;width:52px;height:52px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;font-size:28px;box-shadow:0 4px 14px rgba(0,0,0,.2);cursor:grab;animation:beat 1.8s ease-in-out infinite}
@keyframes beat{0%,100%{transform:scale(1)}50%{transform:scale(1.08)}}
.swipe-note{font-size:14px;opacity:.8;letter-spacing:2px;text-transform:uppercase}
.frame{width:min(78vw,320px);aspect-ratio:736/1000;border-radius:160px 160px 18px 18px;overflow:hidden;box-shadow:0 18px 50px rgba(150,70,80,.3);border:6px solid var(--paper);position:relative;animation:bloom 1.6s cubic-bezier(.2,.8,.2,1) both}
.frame img{width:100%;height:100%;object-fit:cover;object-position:center 30%;animation:drift 14s ease-in-out infinite alternate}
@keyframes bloom{from{opacity:0;transform:scale(.88)}to{opacity:1;transform:none}}
@keyframes drift{from{transform:scale(1.02)}to{transform:scale(1.12) translateY(-1.5%)}}
h1.script{font-family:'Great Vibes',cursive;font-weight:400;font-size:clamp(38px,11vw,52px);color:var(--rose);margin-top:22px;text-align:center;line-height:1.1;animation:pop 1.2s .8s both}
.btn{margin-top:22px;padding:12px 30px;border-radius:30px;border:1px solid var(--rose);background:transparent;color:var(--rose);font-family:inherit;font-size:19px;font-style:italic;cursor:pointer;transition:all .3s;animation:pop 1s 1.6s both}
.btn:hover,.btn:active{background:var(--rose);color:#fff}
.letter{width:min(88vw,380px);max-height:82vh;overflow:auto;background:var(--paper);padding:34px 28px 28px;border-radius:6px;box-shadow:0 14px 40px rgba(120,70,60,.22);position:relative;transform:rotate(-1deg);background-image:repeating-linear-gradient(transparent 0,transparent 33px,rgba(217,100,124,.14) 34px)}
.letter::before{content:"";position:absolute;top:0;left:34px;bottom:0;width:1px;background:rgba(217,100,124,.28)}
.letter .to{font-family:'Caveat',cursive;font-size:28px;color:var(--rose);margin-bottom:6px;padding-left:12px}
.letter p{font-family:'Caveat',cursive;font-size:25px;line-height:34px;padding-left:12px;opacity:0;transform:translateY(8px);animation:line 1s forwards}
.letter p:nth-of-type(1){animation-delay:.8s}.letter p:nth-of-type(2){animation-delay:2s}.letter p:nth-of-type(3){animation-delay:3.4s}.letter p:nth-of-type(4){animation-delay:5s}
.letter .sign{text-align:right;font-family:'Great Vibes',cursive;font-size:30px;color:var(--rose);margin-top:10px;opacity:0;animation:line 1s 6.4s forwards}
@keyframes line{to{opacity:1;transform:none}}
.slide.on .letter{animation:bloom 1.2s both}
.bouquet{position:relative;width:min(80vw,330px);display:flex;flex-direction:column;align-items:center;animation:bloom 1.6s cubic-bezier(.2,.8,.2,1) both}
.bouquet .blooms{width:100%;aspect-ratio:736/900;overflow:hidden;border-radius:50% 50% 30% 30%/46% 46% 12% 12%;-webkit-mask-image:linear-gradient(180deg,#000 80%,transparent 100%);mask-image:linear-gradient(180deg,#000 80%,transparent 100%);animation:sway 6s ease-in-out infinite alternate;transform-origin:50% 100%}
.bouquet .blooms img{width:100%;height:100%;object-fit:cover;object-position:center 22%}
@keyframes sway{from{transform:rotate(-1.2deg)}to{transform:rotate(1.2deg)}}
.wrap{width:62%;height:130px;margin-top:-62px;background:linear-gradient(160deg,#e9cfae,#d3ae86);clip-path:polygon(0 0,100% 0,56% 100%,44% 100%);position:relative;z-index:2}
.wrap::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(255,255,255,.22),transparent 40%,rgba(0,0,0,.08))}
.bow{position:absolute;bottom:22px;z-index:3;width:84px}
.final{font-family:'Great Vibes',cursive;font-size:clamp(34px,10vw,46px);color:var(--rose);margin-top:16px;text-align:center;animation:pop 1.2s 1s both}
.sub{font-size:19px;font-style:italic;opacity:.85;margin-top:2px;text-align:center;animation:pop 1.2s 1.6s both}
.floaters{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.floaters span{position:absolute;bottom:-40px;font-family:'Caveat',cursive;color:var(--rose);opacity:0;animation:rise linear infinite;white-space:nowrap}
@keyframes rise{0%{transform:translateY(0) translateX(0);opacity:0}15%{opacity:.34}85%{opacity:.34}100%{transform:translateY(-105vh) translateX(18px);opacity:0}}
.petals i{position:absolute;top:-30px;width:12px;height:16px;border-radius:70% 0 70% 0;background:linear-gradient(135deg,#f6b4c0,#e57d95);opacity:0;animation:fall linear infinite}
@keyframes fall{0%{transform:translateY(0) rotate(0);opacity:0}10%{opacity:.7}100%{transform:translateY(110vh) translateX(40px) rotate(380deg);opacity:0}}
.back{position:absolute;top:calc(14px + env(safe-area-inset-top,0px));right:16px;font-size:15px;font-style:italic;color:var(--rose);background:none;border:none;cursor:pointer;opacity:.7;z-index:5}
</style>
</head>
<body>

<section class="slide on" id="lock">
<div class="bg" style="background-image:url(data:image/jpeg;base64,)"></div>
<div class="shade"></div>
<div class="clock"><div class="time" id="t">9:41</div><div class="date" id="d"></div></div>
<div class="notif"><b>💌 MANISH</b><span>I have something for you, Jahanvi…</span></div>
<div style="width:100%;display:flex;flex-direction:column;align-items:center;gap:14px">
<div class="track" id="track"><div class="hint">slide the heart to open</div><div class="knob" id="knob">💗</div></div>
<div class="swipe-note">just for you</div>
</div>
</section>

<section class="slide" id="s2">
<div class="frame"><img src="data:image/jpeg;base64," alt="Lilies"></div>
<h1 class="script">flowers for you, Jahanvi</h1>
<button class="btn" data-go="s3">open my letter</button>
</section>

<section class="slide" id="s3">
<div class="letter">
<div class="to">Dear Jahanvi,</div>
<p>hello bbg,</p>
<p>please maan jaaa, tu kehti thi na mrko pregnant krdegi chod k pregnant toh krdiya ab delivery kra de</p>
<p>maan jaaa bbg i am so sororrryyyy plewaasseeeeeeeeeeeeeeee.</p>
<p>&nbsp;</p>
<div class="sign">yours, Manish</div>
</div>
<button class="btn" data-go="s4" style="animation-delay:7s">one more thing</button>
</section>

<section class="slide" id="s4">
<div class="floaters" id="fl"></div>
<div class="petals" id="pt"></div>
<button class="back" data-go="s2">replay ↺</button>
<div class="bouquet">
<div class="blooms"><img src="data:image/jpeg;base64," alt="Lily bouquet"></div>
<div class="wrap"></div>
<svg class="bow" viewBox="0 0 100 60"><path d="M50 30 C30 0 4 4 6 28 C8 52 34 44 50 30Z" fill="#e57d95"/><path d="M50 30 C70 0 96 4 94 28 C92 52 66 44 50 30Z" fill="#e57d95"/><path d="M50 30 L34 58 L46 50Z M50 30 L66 58 L54 50Z" fill="#d9647c"/><circle cx="50" cy="30" r="8" fill="#c94f69"/></svg>
</div>
<div class="final">I'm sorry, Jahanvi</div>
<div class="sub">maan jaa na, please ♡</div>
</section>

<script>
(function(){
var now=new Date();
var h=now.getHours()%12||12,m=('0'+now.getMinutes()).slice(-2);
document.getElementById('t').textContent=h+':'+m;
document.getElementById('d').textContent=now.toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric'});

function show(id){
document.querySelectorAll('.slide').forEach(function(s){s.classList.remove('on')});
var el=document.getElementById(id);
void el.offsetWidth;
el.classList.add('on');
}
document.querySelectorAll('[data-go]').forEach(function(b){b.addEventListener('click',function(){show(b.getAttribute('data-go'))})});

var track=document.getElementById('track'),knob=document.getElementById('knob');
var drag=false,startX=0,pos=0,max=0;
function setPos(x){pos=Math.max(0,Math.min(max,x));knob.style.transform='translateX('+pos+'px)'}
knob.addEventListener('pointerdown',function(e){drag=true;startX=e.clientX-pos;max=track.clientWidth-knob.clientWidth-10;knob.style.animation='none';knob.setPointerCapture(e.pointerId);knob.style.transition='none'});
knob.addEventListener('pointermove',function(e){if(drag)setPos(e.clientX-startX)});
function end(){
if(!drag)return;drag=false;
knob.style.transition='transform .35s ease';
if(pos>max*.82){setPos(max);setTimeout(function(){show('s2')},250)}
else{setPos(0)}
}
knob.addEventListener('pointerup',end);
knob.addEventListener('pointercancel',end);

var words=['sorry','sorry bbg','maan jaa','sorry','please','i love you','sorry','sorry jahanvi'];
var fl=document.getElementById('fl');
for(var i=0;i<9;i++){
var s=document.createElement('span');
s.textContent=words[i%words.length];
s.style.left=(6+Math.random()*80)+'%';
s.style.fontSize=(16+Math.random()*12)+'px';
s.style.animationDuration=(14+Math.random()*10)+'s';
s.style.animationDelay=(i*2.2)+'s';
fl.appendChild(s);
}
var pt=document.getElementById('pt');
for(var j=0;j<9;j++){
var p=document.createElement('i');
p.style.left=(Math.random()*95)+'%';
p.style.animationDuration=(9+Math.random()*7)+'s';
p.style.animationDelay=(Math.random()*9)+'s';
pt.appendChild(p);
}
})();
</script>
</body>
</html>
